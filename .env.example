PORT=3000

# Private backend decision key
TOKUN_API_KEY=

# Optional HTTP Basic protection for the public EC2 IP.
# Username is always: quant
DASHBOARD_PASSWORD=

# TradingView browser source
MARKET_DISPLAY_NAME=NASDAQ 100
TRADINGVIEW_SYMBOL=NASDAQ:NDX
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/
TRADINGVIEW_TECHNICALS_URL=
TRADINGVIEW_STORAGE_STATE=
TRADINGVIEW_SETTLE_MS=4500
TRADINGVIEW_SCRAPE_TECHNICALS=true

# Paper account
STARTING_BALANCE_NIS=2000
LEVERAGE=40
MAX_MARGIN_PER_TRADE_NIS=450
MAX_RISK_PER_TRADE_NIS=15
MAX_DAILY_LOSS_NIS=120
DAILY_BENCHMARK_NIS=40
SPREAD_POINTS=1.8

# Automation
CYCLE_MINUTES=15
AUTO_START=true
RUN_ON_START=true
