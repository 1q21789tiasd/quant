# Quant v3 — NQ1! paper-only simulation, no live broker integration.
# Localhost dashboard (do not expose without TLS/auth reverse proxy)
PORT=3000
HOST=127.0.0.1
DASHBOARD_PASSWORD=

# FREE Massive Futures Basic: 5 API calls/min; historical data ~8 HOURS DELAYED.
# Create free account: https://massive.com/futures
MASSIVE_API_KEY=
# Dated NQ contract. At time of writing NQZ6 is December 2026; verify rollover.
MASSIVE_CONTRACT=NQZ6
LOOKBACK_DAYS=14
PAPER_RISK_USD=15
USD_ILS_RATE=0

# OPTIONAL: separate authorized fresh 1-minute futures feed -> local-paper auto execution.
# Leave off until your own legitimate fresh CME data provider is configured.
PAPER_AUTOMATION_ENABLED=false
PAPER_CONTRACT_TICKER=NQZ6
FEED_TOKEN=
