PORT=3000

# Private backend decision key
TOKUN_API_KEY=

# Optional HTTP Basic protection for the public EC2 IP.
# Username is always: quant
DASHBOARD_PASSWORD=

# TradingView browser source
MARKET_DISPLAY_NAME=E-mini Nasdaq-100 Futures (NQ1!)
TRADINGVIEW_SYMBOL=CME_MINI:NQ1!
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/Q2Yhm4MH/
TRADINGVIEW_TECHNICALS_URL=
TRADINGVIEW_STORAGE_STATE=
TRADINGVIEW_SETTLE_MS=4500
TRADINGVIEW_SCRAPE_TECHNICALS=true

# Paper account
STARTING_BALANCE_NIS=2000
LEVERAGE=40
MAX_MARGIN_PER_TRADE_NIS=450
MAX_RISK_PER_TRADE_NIS=15
MAX_DAILY_LOSS_NIS=120
DAILY_BENCHMARK_NIS=40
SPREAD_POINTS=1.8

# Automation
CYCLE_MINUTES=15
AUTO_START=false
RUN_ON_START=false

# Important: The saved TradingView NQ1! layout is NOT an authorized NQ futures
# OHLC API. CME quotes on a free TradingView plan may be 10 minutes delayed.
# Chart snapshots are research/preview only; do not treat them as live fills.
# Legacy model-based paper execution remains opt-in and not futures-accurate.
#
# The separate Alpaca v2 engine supports STOCK/ETF PAPER STUDIES ONLY.
# It cannot fetch NQ1! data. No ETF proxy is selected automatically.
QUANT_V2_SYMBOLS=
