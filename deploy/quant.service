[Unit]
Description=Quant Bloodline paper-trading research system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quant
EnvironmentFile=/home/ubuntu/quant/.env
ExecStart=/usr/bin/node /home/ubuntu/quant/server.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
